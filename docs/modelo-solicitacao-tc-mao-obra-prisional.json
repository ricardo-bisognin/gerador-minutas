{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gerador-minutas.local/schemas/solicitacao-tc-mao-obra-prisional.json",
  "title": "Solicitação de Termo de Cooperação para utilização de mão de obra prisional",
  "type": "object",
  "required": ["tipo_convenente", "convenente", "execucao", "vigencia"],
  "properties": {
    "tipo_convenente": {
      "type": "string",
      "enum": ["empresa", "municipio"]
    },
    "identificacao_instrumento": {
      "type": "object",
      "properties": {
        "fpe_numero": {"type": ["string", "null"]},
        "fpe_ano": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
        "processo_numero": {"type": ["string", "null"]},
        "processo_ano": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100}
      }
    },
    "convenente": {
      "type": "object",
      "required": ["nome_razao_social", "cnpj", "representante"],
      "properties": {
        "nome_razao_social": {"type": "string"},
        "cnpj": {"type": "string"},
        "endereco": {"type": ["string", "null"]},
        "numero": {"type": ["string", "null"]},
        "complemento": {"type": ["string", "null"]},
        "bairro": {"type": ["string", "null"]},
        "municipio": {"type": ["string", "null"]},
        "uf": {"type": ["string", "null"]},
        "cep": {"type": ["string", "null"]},
        "telefone": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "homepage": {"type": ["string", "null"]},
        "representante": {
          "type": "object",
          "required": ["nome"],
          "properties": {
            "nome": {"type": "string"},
            "cpf": {"type": ["string", "null"]},
            "rg": {"type": ["string", "null"]},
            "orgao_expedidor": {"type": ["string", "null"]},
            "cargo": {"type": ["string", "null"]},
            "funcao": {"type": ["string", "null"]}
          }
        }
      }
    },
    "execucao": {
      "type": "object",
      "required": ["quantidade_pessoas", "estabelecimentos", "atividades", "local_prestacao", "jornada", "remuneracao"],
      "properties": {
        "quantidade_pessoas": {"type": "integer", "minimum": 1},
        "regimes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "estabelecimentos": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "atividades": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "local_prestacao": {
          "type": "object",
          "required": ["tipo"],
          "properties": {
            "tipo": {
              "type": "string",
              "enum": ["sede_empresa", "sede_estabelecimento_prisional", "outro"]
            },
            "descricao_outro": {"type": ["string", "null"]}
          }
        },
        "jornada": {
          "type": "object",
          "required": ["inicio", "fim"],
          "properties": {
            "inicio": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
            "fim": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
            "intervalo_inicio": {"type": ["string", "null"]},
            "intervalo_fim": {"type": ["string", "null"]},
            "dias_trabalho": {"type": "array", "items": {"type": "string"}},
            "dias_repouso": {"type": "array", "items": {"type": "string"}},
            "carga_horaria_semanal": {"type": ["number", "null"]},
            "regras_feriados": {"type": ["string", "null"]},
            "feriados_especificos": {"type": "array", "items": {"type": "string"}}
          }
        },
        "remuneracao": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": {"type": "string"}
          }
        }
      }
    },
    "vigencia": {
      "type": "object",
      "required": ["anos"],
      "properties": {
        "anos": {"type": "number", "minimum": 0},
        "justificativa": {"type": ["string", "null"]}
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tipo", "nome_arquivo"],
        "properties": {
          "tipo": {"type": "string"},
          "nome_arquivo": {"type": "string"},
          "extraido_automaticamente": {"type": "boolean"},
          "conferencia_status": {
            "type": "string",
            "enum": ["pendente", "conferido", "divergencia"]
          }
        }
      }
    }
  }
}
